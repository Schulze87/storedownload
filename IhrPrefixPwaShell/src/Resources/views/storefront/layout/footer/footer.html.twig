{% sw_extends '@Storefront/storefront/layout/footer/footer.html.twig' %}

{% block layout_footer_inner_container %}
    {{ parent() }}
    {% block pwa_install_bar %}
        <style>
            #pwa-bar {
                display: none;
                position: fixed;
                inset: auto 0 0 0;
                z-index: 9999;
                background: #fff;
                border-top: 1px solid #e0e0e0;
                box-shadow: 0 -4px 20px rgba(0,0,0,.15);
                padding: 12px 16px;
                box-sizing: border-box;
                font-family: system-ui, -apple-system, sans-serif;
            }
            #pwa-bar.is-visible { display: block; }

            #pwa-bar .pwa-row {
                display: flex;
                align-items: center;
                gap: 12px;
                width: 100%;
            }

            #pwa-bar .pwa-logo {
                width: 44px;
                height: 44px;
                border-radius: 10px;
                object-fit: cover;
                flex: 0 0 auto;
            }

            #pwa-bar .pwa-copy {
                flex: 1 1 auto;
                min-width: 0;
            }
            #pwa-bar .pwa-copy strong {
                display: block;
                font-size: 15px;
                font-weight: 600;
                color: #202124;
                line-height: 1.25;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
            #pwa-bar .pwa-copy span {
                display: block;
                font-size: 13px;
                color: #5f6368;
                line-height: 1.25;
                margin-top: 2px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            #pwa-bar .pwa-go {
                flex: 0 0 auto;
                background: #0b57d0;
                color: #fff;
                border: 0;
                border-radius: 999px;
                padding: 10px 20px;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
                white-space: nowrap;
            }
            #pwa-bar .pwa-go:hover { background: #0a4bb5; }

            #pwa-bar .pwa-x {
                flex: 0 0 auto;
                background: none;
                border: 0;
                color: #5f6368;
                font-size: 22px;
                line-height: 1;
                cursor: pointer;
                padding: 6px 4px;
            }

            @media (max-width: 479px) {
                #pwa-bar .pwa-copy span { display: none; }
                #pwa-bar .pwa-go { padding: 9px 16px; font-size: 13px; }
            }

            @media (min-width: 720px) {
                #pwa-bar {
                    inset: auto auto 20px 50%;
                    transform: translateX(-50%);
                    width: 90%;
                    max-width: 560px;
                    border: 1px solid #e0e0e0;
                    border-radius: 14px;
                    box-shadow: 0 8px 28px rgba(0,0,0,.18);
                }
            }
        </style>

        <div id="pwa-bar" role="dialog" aria-label="TGU installieren">
            <div class="pwa-row">
                <img class="pwa-logo" src="/bundles/ihrprefixpwashell/icon-192.png" alt="">
                <div class="pwa-copy">
                    <strong>TGU installieren</strong>
                    <span>Schneller Zugriff vom Startbildschirm</span>
                </div>
                <button id="pwa-go" class="pwa-go" type="button">Installieren</button>
                <button id="pwa-x" class="pwa-x" type="button" aria-label="Schließen">&times;</button>
            </div>
        </div>
    {% endblock %}
{% endblock %}
