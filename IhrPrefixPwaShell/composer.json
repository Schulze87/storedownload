{
    "name": "ihr-prefix/pwa-shell",
    "description": "Minimal PWA shell for Shopware 6 storefront",
    "version": "1.0.0",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Ihr Name"
        }
    ],
    "require": {
        "shopware/core": "~6.6.0"
    },
    "autoload": {
        "psr-4": {
            "IhrPrefix\\PwaShell\\": "src/"
        }
    },
    "extra": {
        "shopware-plugin-class": "IhrPrefix\\PwaShell\\IhrPrefixPwaShell",
        "label": {
            "de-DE": "PWA Shell",
            "en-GB": "PWA Shell"
        }
    }
}
